# 运行环境：非 dev/development/test 时，弱 JWT_SECRET 会拒绝启动
ENV=dev

# 数据库（docker-compose 提供的 pgvector/pg16）
DATABASE_URL=postgresql+asyncpg://crm:crm123@localhost:5432/crmnkb

# CORS 显式域名白名单（逗号分隔；生产环境改为实际前端域名）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=720

# 上传目录（相对 backend 目录）
UPLOAD_DIR=data/uploads
# 单文件上传上限（MB），超限返回 413
MAX_UPLOAD_MB=100

# 备份用的 PG 容器名：非空则用 `docker exec <容器> pg_dump/psql`，留空则用本机二进制
PG_DOCKER_CONTAINER=crmnkb-postgres

# 系统告警检查（磁盘/内存/LLM 失败超阈值时通知管理员）
ALERT_INTERVAL_SECONDS=300
ALERT_DISK_PERCENT=85
ALERT_MEM_PERCENT=90
ALERT_LLM_FAIL_WINDOW_MIN=10
ALERT_LLM_FAIL_THRESHOLD=5

# 前端构建产物目录（裸机单端口部署用，相对 backend 目录或绝对路径）。
# 配置后由后端直接托管前端静态资源与 SPA 路由回退，无需 nginx；
# 留空则不启用（独立 nginx 托管前端等部署方式不受影响）
FRONTEND_DIST=

# LLM 提供方: api=OpenAI 兼容接口, ollama=本地 Ollama
LLM_CHAT_PROVIDER=api
LLM_EMBED_PROVIDER=ollama

# OpenAI 兼容 API 配置
# 注意：DeepSeek 没有 embedding 接口，LLM_EMBED_PROVIDER=api 时请把
# LLM_API_BASE_URL 指向 OpenAI 或其他兼容 embedding 的服务；
# 本地开发推荐 LLM_EMBED_PROVIDER=ollama + bge-m3。
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_API_CHAT_MODEL=deepseek-chat
LLM_API_EMBED_MODEL=text-embedding-3-small
# 非流式 chat 调用超时（秒）；自定义报告等长文 HTML 生成建议 >= 180
LLM_CHAT_TIMEOUT_SECONDS=180

# Ollama 本地服务
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3

# 向量维度（bge-m3 = 1024，修改后需重建 document_chunks 表）
EMBEDDING_DIM=1024

# RAG
RAG_SCORE_THRESHOLD=0.5
RAG_TOP_K=5
# 混合检索：true=向量+关键词(pg_trgm) RRF 融合；false=纯向量检索
RAG_HYBRID=true
# Small2Big：命中切片拼接同文档相邻 ±N 个切片作为上下文
RAG_NEIGHBOR_WINDOW=1
# 多轮对话问题改写（指代消解），失败自动用原问题
RAG_QUERY_REWRITE=true
# Rerank 精排（chat LLM 打 0~1 相关分，失败回退 RRF 序）
RAG_RERANK=true
# 选中的 file_ids 总字符数低于该阈值时直接读全文进 prompt（跳过 RAG，适合小文档问答）
RAG_DIRECT_FILE_MAX_CHARS=50000
# 检索模式：blend=pgvector+tsvector 二阶段（推荐），embedding=纯向量，keywords=纯 tsvector BM25
RAG_SEARCH_MODE=blend
# 自动生成问题：ingestion 时为每个 chunk 用 LLM 生成候选问题入 chunk_questions 表
RAG_GENERATE_QUESTIONS=true
# 每个 chunk 生成的候选问题数（3-5 性价比最好）
RAG_QUESTIONS_PER_CHUNK=3
# 上下文长度裁剪（按融合排序累计到该字符上限）
RAG_MAX_CONTEXT_CHARS=4000
# 工作台聊天未命中知识库时的兜底：true=降级为普通对话由 LLM 用通用知识回答
# （会声明"未参考企业知识库"）；false=固定回复"未在知识库中找到相关信息"
CHAT_FALLBACK_TO_LLM=true
# 工作台聊天"深度思考"开关：
# 默认是否开启思考；关闭思考时随请求发送的模型参数名（MiniMax 兼容接口为
# enable_thinking，其他服务商按文档调整；置空则不发送该参数）
CHAT_DEFAULT_THINKING=true
LLM_CHAT_THINKING_PARAM=enable_thinking
# 图片/扫描PDF的OCR方案：auto=本地OCR优先(RapidOCR→Tesseract)再视觉，
# rapidocr/tesseract=强制本地（不可用回退视觉），vision=只用视觉模型
OCR_PROVIDER=auto
# 图片本地 OCR 文本达到该字符数视为"含文字"，直接用 OCR；否则交给视觉模型描述
OCR_IMAGE_MIN_CHARS=10
# 扫描 PDF 每页本地 OCR 最低字符数，低于则整份回退视觉模型
OCR_PDF_MIN_CHARS_PER_PAGE=20

# 客户画像聚合内容字符上限
PROFILE_MAX_CHARS=8000

# 提醒规则引擎调度间隔（分钟）
REMINDER_INTERVAL_MINUTES=10

# 系统更新脚本（裸机部署用；留空=「系统设置 → 系统更新」按钮隐藏）
# 模板见 deploy/update.sh；服务用户需配置 systemctl restart 免密 sudo
UPDATE_SCRIPT=

# SMTP 邮件服务（工作流 send_email 动作用；SMTP_HOST 留空则邮件功能优雅降级）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true

# 文档切片
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# dsh agent 基座（阶段 2 ACP：默认关闭，开启后 /chat/ask/agent/stream 可用）
# 桥接层为单租户单 dsh ACP 进程（dsh --profile acp），每会话 session/new|resume
# 动态挂载知识库 MCP（headers 携带该用户新签的 dsh-mcp 令牌）
DSH_AGENT_ENABLED=false
# dsh 可执行文件路径（必填）：Windows 必须指 .cmd shim，Linux 指无后缀 shim
DSH_BIN=
# dsh 运行时 home（profile/插件注册态）/ patch yml 目录 / agent 会话工作目录
# （相对 backend 目录；所有会话共用同一 cwd——session/resume 要求 cwd 一致）
DSH_HOME=data/dsh/home
DSH_PATCHES_DIR=data/dsh/patches
DSH_WORKSPACE_ROOT=data/dsh/workspace
# （ACP 阶段已弃用，保留仅为兼容旧 .env：模型路由固定为进程级 patch 里的
#  llm-pi-ai kbcrm 路由，模型名取自 DB 默认 chat 模型，进程重建时刷新）
DSH_PROVIDER=kbcrm
# 注入 dsh 的知识库 MCP server 地址
DSH_MCP_URL=http://127.0.0.1:8100/api/mcp
# dsh 专用 MCP 令牌有效期（分钟，默认 7 天；每次会话激活时新签，不落盘，
# 过期不再导致 MCP 401——下次 session/new|resume 自动换发）
DSH_MCP_TOKEN_EXPIRE_MINUTES=10080
