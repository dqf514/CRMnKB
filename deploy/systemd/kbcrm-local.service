# 榜样知识库后端 systemd 服务（本机裸机单端口部署）
# 前端 dist 由 FastAPI 直接托管（.env 里 FRONTEND_DIST 指向 frontend/dist），
# 无需 nginx；网关 nginx 只需把整个站点反代到 0.0.0.0:8100 即可。
# 安装：sudo cp kbcrm-local.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now kbcrm-local
[Unit]
Description=榜样知识库 (FastAPI 后端 + 前端静态托管)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=crmnkb
Group=crmnkb
WorkingDirectory=/var/www/kbcrm/backend
ExecStart=/var/www/kbcrm/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8100 --workers 1
Restart=always
RestartSec=3
# 单进程即可：应用内置提醒/告警/恢复等后台任务，多进程会重复执行
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
